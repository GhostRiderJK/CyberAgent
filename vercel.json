{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "src",
      "framework": "fastapi",
      "env": {
        "VERCEL": "1"
      }
    },
    "web": {
      "root": "frontend",
      "framework": "vite",
      "env": {
        "VITE_API_BASE_URL": "",
        "VITE_API_PATH_PREFIX": "/api"
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}