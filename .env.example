# Environment variables for CyberAgent
# Copy to .env and adjust. The .env file is gitignored - never commit real keys.

# ---- LLM (used by the investigation agent; see src/cyberagent/llm.py) ----
# Backend: openai (any OpenAI-compatible server) | ollama | mock
LLM_BACKEND=openai

# Omnirouter local proxy (OpenAI-compatible), masked to localhost only
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_omnirouter_key_here
LLM_MODEL=nvidia/qwen3-next-80b-a3b-instruct

# Alternative: local Ollama
# LLM_BACKEND=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2:3b

# Optional tuning
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_S=120
