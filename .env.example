# Environment variables for CyberAgent
# Copy to .env and adjust. The .env file is gitignored - never commit real keys.

# ---- LLM (used by the investigation agent; see src/cyberagent/llm.py) ----
# Backend: ollama (native /api/chat) | openai (any OpenAI-compatible server) | mock
LLM_BACKEND=ollama

# Local Ollama: unset LLM_BASE_URL also falls back to this address
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# Alternative: any OpenAI-compatible server
# LLM_BACKEND=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=your-model-id

# Optional tuning
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_S=120
